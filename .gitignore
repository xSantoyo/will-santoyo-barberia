# --- Herramientas locales portables (no forman parte del repo) ---
.tools/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / Next.js ---
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# --- Entornos y secretos (NUNCA commitear credenciales reales) ---
.env
.env.*
!.env.example

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- Contenido real del cliente (fotos pesadas se gestionan por S3, no por git) ---
content/will-barbershop/gallery/*
content/will-barbershop/profile/*
content/will-barbershop/cuts/*
!content/will-barbershop/**/.gitkeep

# --- SO / editores ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Datos locales ---
*.db
*.sqlite3
frontend/e2e/.demo-queue.json
n8n-data/
pg-data/

# --- Correos de desarrollo (outbox local del backend) ---
backend/outbox/

# Skills instaladas por npx skills (viven en el perfil de usuario, no en el repo)
.agents/
.claude/

# Originales de video en 4K (313 MB): se quedan en el disco, no en el repo.
# Los MP4 comprimidos tampoco: viven en content/, como el resto de medios.
_originales-video/

# Videos publicables. Fuera del repo A PROPOSITO, y TODOS por igual:
# algunos muestran clientes menores de edad, y si solo se excluyeran esos, el
# propio .gitignore estaria senalando cuales son. Un repositorio publico
# conserva para siempre lo que entra, incluso en bifurcaciones de terceros, asi
# que retirar un clip del sitio no bastaria para retirarlo del mundo. Aqui
# basta con borrar el archivo. Los sirve el backend en /media/.
content/will-barbershop/videos/*
!content/will-barbershop/videos/.gitkeep

# Capturas de verificacion: se generan con los scripts de frontend/e2e/ y son
# evidencia del momento de la revision, no las consume nadie en ejecucion.
# Pesan mas que el codigo y este repo es publico.
docs/screenshots/
