# Copiar a .env para desarrollo local SIN docker-compose.
# En producción NADA de esto va en archivos: AWS Secrets Manager (ver infra/).

ENVIRONMENT=local
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://willsantoyo:willsantoyo@localhost:5432/willsantoyo

JWT_SECRET=cambia-esto-por-una-clave-larga-aleatoria
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Cuando el dueño tenga la cuenta de comercio: sandbox con las llaves pub_test_/
# prv_test_, y production con las reales. Sin cambios de código.

# Almacenamiento: local (carpeta content/) o s3
STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=../content
# S3_BUCKET=willsantoyo-prod-media
# CDN_BASE_URL=https://dxxxx.cloudfront.net

# --- Semilla del panel ---
# Contraseña inicial del usuario administrador. Si se deja vacía, la semilla
# genera una aleatoria y la imprime UNA vez en el log del arranque.
# Nunca se escribe en el código: este repositorio es público.
# SEED_ADMIN_USERNAME=will
# SEED_ADMIN_PASSWORD=
