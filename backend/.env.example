# Copiar a .env para desarrollo local SIN docker-compose.
# En producción NADA de esto va en archivos: AWS Secrets Manager (ver infra/).

ENVIRONMENT=local
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://badboys:badboys@localhost:5432/badboys

JWT_SECRET=cambia-esto-por-una-clave-larga-aleatoria
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# n8n (vacío = webhooks deshabilitados, quedan auditados como fallidos)
N8N_WEBHOOK_BASE=http://localhost:5678
N8N_WEBHOOK_SECRET=local-webhook-secret
SERVICE_API_KEY=local-service-key

# Almacenamiento: local (carpeta content/) o s3
STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=../content
# S3_BUCKET=badboys-prod-media
# CDN_BASE_URL=https://dxxxx.cloudfront.net
